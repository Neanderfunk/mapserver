# HVB-Ortung: Meldungen nach 14 Tagen loeschen (Konzept 4.4 Punkt 7)
[Unit]
Description=HVB-Ortung: Meldungen aelter als 14 Tage loeschen

[Service]
Type=oneshot
ExecStart=/usr/bin/find /var/lib/locator/eingang -type f -name *.json -mtime +13 -delete
ExecStart=/usr/bin/find /var/lib/locator/eingang -mindepth 1 -type d -empty -delete
