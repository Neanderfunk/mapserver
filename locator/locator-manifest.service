# HVB-Manifest fuer den nodeplacer neu erzeugen und signieren (manifest.py).
# Als root: der Signierschluessel ist nur fuer root lesbar (adorfer 20.11.2026).
[Unit]
Description=HVB-Ortung: nodeplacer-Manifest erzeugen und signieren
# erst die Position holen; schlaegt das fehl, kommt das Manifest trotzdem
Wants=locator-orten.service
After=locator-orten.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/locator/manifest.py
ProtectSystem=strict
ReadWritePaths=/var/www/locator/hvb/nodeplacer
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
