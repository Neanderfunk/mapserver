[Unit]
Description=unifi_respondd, meldet UniFi-Accesspoints als respondd-Knoten
Documentation=https://github.com/Neanderfunk/unifi_respondd
After=network-online.target yanic@neander.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=unifi-respondd
Group=unifi-respondd
# unifi_respondd liest ./unifi_respondd.yaml (auch fuer die Log-Einstellung)
WorkingDirectory=/etc/unifi_respondd
# Nur batman-Instanzen, die gerade existieren; Zugangsdaten aus
# /etc/unifi_respondd/zugang. Als root, danach laeuft der Dienst als
# unifi-respondd.
ExecStartPre=+/bin/sh -c 'umask 027 && /usr/local/sbin/karte-unifi-respondd-conf > /etc/unifi_respondd/unifi_respondd.yaml.neu && chgrp unifi-respondd /etc/unifi_respondd/unifi_respondd.yaml.neu && mv /etc/unifi_respondd/unifi_respondd.yaml.neu /etc/unifi_respondd/unifi_respondd.yaml'
ExecStart=/opt/unifi_respondd/venv/bin/python /opt/unifi_respondd/respondd.py
Restart=always
RestartSec=30
# Port 1001 ist privilegiert
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
