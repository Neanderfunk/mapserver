[Unit]
Description=yanic, respondd-Sammler der Community %i
Documentation=https://github.com/Neanderfunk/yanic
After=network-online.target victoria-metrics.service
Wants=network-online.target
# yanic prueft beim Start, ob die Zeitreihen-Datenbank antwortet, und beendet
# sich sonst. Nur fuer Communities mit Zeitreihe relevant, schadet den anderen
# nicht, weil After ohne Wants nichts nachzieht.
StartLimitIntervalSec=0

[Service]
Type=simple
User=yanic
Group=www-data
UMask=0022
# Adressen, die per Rundruf nicht erreichbar sind, fragt yanic zusaetzlich
# einzeln. Die Liste erzeugt karte-ziele-ernten aus der Translation Table,
# die batman uns als Mitglied des Mesh ohnehin zustellt. Fehlt die Datei,
# aendert sich nichts. Braucht den Fork Neanderfunk/yanic (seeds).
Environment=YANIC_SEEDS=/etc/karte-en/ziele-%i.txt
# yanic stirbt, wenn eine Schnittstelle fehlt. Nach einem Neustart der
# Maschine ist das normal, also erst warten (als root, danach faellt der
# Dienst auf den Benutzer yanic zurueck).
# Die Vorgabe von 90 Sekunden reicht nicht: nach einem Neustart der Maschine
# setzt der Tunneldigger-Client die MTU erst rund zwanzig Sekunden nach dem
# Verbindungsaufbau, danach sortiert batman sich neu. karte-en-warten gibt
# nach 180 Sekunden ohnehin von selbst auf.
TimeoutStartSec=300
ExecStartPre=+/usr/local/sbin/karte-en-warten %i
# Konfiguration bei jedem Start neu erzeugen: sie enthaelt nur Domains, deren
# batman-Instanz gerade existiert. Sonst reisst ein einziger Broker, der nicht
# antwortet, den ganzen Sammler mit.
ExecStartPre=+/bin/sh -c '/usr/local/sbin/karte-en-yanic-conf %i > /etc/yanic-%i.conf'
ExecStart=/usr/local/bin/yanic serve --config /etc/yanic-%i.conf
Restart=always
RestartSec=30
# yanic fragt nur ueber UDP und schreibt JSON, mehr braucht es nicht.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/www/karte-en/sites
# Service-Menue (service/): Aliase lesen, erledigte Loeschauftraege entfernen.
# Das Verzeichnis gehoert karte-service:yanic; "-" laesst die Unit auch ohne es
# starten (Communities ohne Service-Menue).
SupplementaryGroups=yanic
ReadWritePaths=-/var/lib/karte/service
StateDirectory=yanic

[Install]
WantedBy=multi-user.target
