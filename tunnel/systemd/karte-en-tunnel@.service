[Unit]
Description=Tunneldigger zu Freifunk EN, Domain %i
Documentation=https://github.com/wlanslovenija/tunneldigger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/karte-en-tunnel %i
Restart=always
RestartSec=15
# Der Client legt L2TP-Sitzungen und batman-Schnittstellen an, das braucht
# Netz-Rechte. Alles andere bleibt ihm verwehrt.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/proc/sys/net

[Install]
WantedBy=multi-user.target
